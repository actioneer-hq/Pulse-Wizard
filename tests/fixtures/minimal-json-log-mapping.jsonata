(
  $turn := events[stage = "turn"][0].id;
  {
    "header": {
      "call_id": call.id,
      "source": "json-log-fixture",
      "environment": "test",
      "started_at": call.started_at,
      "ended_at": call.ended_at
    },
    "spans": $map(events, function($e) {
      {
        "span_id": $e.id,
        "parent_span_id": null,
        "name": $e.stage,
        "stage": $e.stage,
        "t_start": $e.start_ms / 1000,
        "t_end": $e.end_ms / 1000,
        "turn_id": $e.stage = "call" ? null : $turn,
        "error": false,
        "attrs": $e.stage = "llm" ? {"metrics.ttft": $e.ttft_ms / 1000} : {},
        "content": {},
        "events": []
      }
    })
  }
)
