{
  "name": "pulse-wizard",
  "version": "0.0.1",
  "description": "Onboarding CLI for Pulse — wire a voice agent's OTLP + audio into a self-hosted Pulse.",
  "type": "module",
  "bin": {
    "pulse-wizard": "dist/cli.js"
  },
  "files": ["dist", "src/skills"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "workbench:list": "node workbench/materialize.mjs --list",
    "workbench:materialize": "node workbench/materialize.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "jsonata": "^2.2.2",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^20.14.0",
    "tsup": "^8.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
