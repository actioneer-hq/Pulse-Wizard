{
  "name": "@actioneer/pulse-wizard",
  "version": "0.1.0",
  "description": "One-command onboarding for voice-agent telemetry and storage in Pulse.",
  "type": "module",
  "bin": {
    "pulse-wizard": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glitchcraft-Inc/Pulse-Wizard.git"
  },
  "license": "MIT",
  "files": ["dist", "src/skills"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run typecheck && npm run lint && npm test",
    "workbench:list": "node workbench/materialize.mjs --list",
    "workbench:materialize": "node workbench/materialize.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "jsonata": "^2.2.2",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^20.14.0",
    "tsup": "^8.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
